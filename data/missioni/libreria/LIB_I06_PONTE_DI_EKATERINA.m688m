-- chiusura: codice 120 a missione conclusa, 121 a tempo scaduto (il giudizio lo danno gli obiettivi)
script.R_chiusura = function(u)
  m688.dopo(u, 20, "R_chiusura")
  do return end
  ::fine::
  m688.messaggio(u, 120)
end
script.R_tempo = function(u)
  m688.messaggio(u, 34)
  m688.messaggio(u, 121)
end

-- regole «quando... allora...» dell'editor: un controllo ogni 10 s sull'unita' della regola
local ZONE = {
  ["bastione"] = { -3945.8, 55564.2, 25000 },
}
-- violato_1
script.R_regola_0 = function(u)
  if m688.variabile_uguale(u, 200, 0) and m688.in_cerchio(u, table.unpack(ZONE["bastione"])) then
    m688.variabile(u, 200, 1)
    m688.messaggio(u, 141)
    do return end
  end
  m688.dopo(u, 10, "R_regola_0")
end
-- violato_2
script.R_regola_1 = function(u)
  if m688.variabile_uguale(u, 201, 0) and m688.in_cerchio(u, table.unpack(ZONE["bastione"])) then
    m688.variabile(u, 201, 1)
    m688.messaggio(u, 141)
    do return end
  end
  m688.dopo(u, 10, "R_regola_1")
end
-- seconda_ondata
script.R_regola_2 = function(u)
  if m688.variabile_uguale(u, 202, 0) and not m688.unita_esiste(u, 2) and m688.variabile_uguale(u, 300, 0) then
    m688.variabile(u, 202, 1)
    m688.variabile(u, 300, 1)
    if m688.unita_esiste(u, 3) then
      m688.seleziona(u, 3)
      m688.posizione(u, 31947.4, -22145.8)
      m688.rotta_ora(u, 313.7)
      m688.velocita_ora(u, 10)
      script.R_3_p1(u)
    end
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_2")
end
-- seconda_ondata_a_tempo
script.R_regola_3 = function(u)
  if m688.variabile_uguale(u, 203, 0) and m688.variabile_uguale(u, 300, 0) then
    m688.variabile(u, 203, 1)
    m688.variabile(u, 300, 1)
    if m688.unita_esiste(u, 3) then
      m688.seleziona(u, 3)
      m688.posizione(u, 31947.4, -22145.8)
      m688.rotta_ora(u, 313.7)
      m688.velocita_ora(u, 10)
      script.R_3_p1(u)
    end
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_3")
end
-- gruppo
script.R_regola_4 = function(u)
  if m688.variabile_uguale(u, 204, 0) then
    m688.variabile(u, 204, 1)
    if m688.unita_esiste(u, 6) then
      m688.seleziona(u, 6)
      m688.posizione(u, 125149, -93266.3)
      m688.rotta_ora(u, 311.9)
      m688.velocita_ora(u, 14)
      script.R_6_p1(u)
    end
    if m688.unita_esiste(u, 7) then
      m688.seleziona(u, 7)
      m688.posizione(u, 120168.3, -92827)
      m688.rotta_ora(u, 311.9)
      m688.velocita_ora(u, 14)
      script.R_7_p1(u)
    end
    if m688.unita_esiste(u, 8) then
      m688.seleziona(u, 8)
      m688.posizione(u, 124176.1, -88361.8)
      m688.rotta_ora(u, 311.9)
      m688.velocita_ora(u, 14)
      script.R_8_p1(u)
    end
    if m688.unita_esiste(u, 9) then
      m688.seleziona(u, 9)
      m688.posizione(u, 128125.8, -95938.1)
      m688.rotta_ora(u, 311.9)
      m688.velocita_ora(u, 14)
      script.R_9_p1(u)
    end
    if m688.unita_esiste(u, 10) then
      m688.seleziona(u, 10)
      m688.posizione(u, 123660.6, -91930.4)
      m688.rotta_ora(u, 311.9)
      m688.velocita_ora(u, 54)
      script.R_10_p1(u)
    end
    m688.radio(u, "PORTAEREI")
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_4")
end

return missione
