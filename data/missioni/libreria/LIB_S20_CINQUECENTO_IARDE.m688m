-- cinquecento_iarde
script.R_regola_3 = function(u)
  if m688.variabile_uguale(u, 203, 0) and (m688.distanza_da(u, 2) or 1e18) < 457 then
    m688.variabile(u, 203, 1)
    m688.variabile(u, 307, 0)
    do return end
  end
  m688.dopo(u, 10, "R_regola_3")
end
-- nuovo_schema
script.R_regola_4 = function(u)
  if m688.variabile_uguale(u, 204, 0) then
    m688.variabile(u, 204, 1)
    if m688.unita_esiste(u, 2) then
      m688.seleziona(u, 2)
      m688.quota(u, 130, 1)
      m688.salva_modello(u)
    end
    if m688.unita_esiste(u, 2) then
      m688.seleziona(u, 2)
      m688.vai_a(u, 47517.1, 20956.9, 30, "")
      m688.telegrafo(u, 0.078)
      m688.salva_modello(u)
      UNITA[2].rotta = true
      UNITA[2].crociera = 0.078
    end
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_4")
end
-- classificati_1
script.R_regola_5 = function(u)
  if m688.variabile_uguale(u, 205, 0) and su_unita(u, 2, m688.classificato, 0, 1) then
    m688.variabile(u, 205, 1)
    m688.variabile(u, 305, 0)
    do return end
  end
  m688.dopo(u, 10, "R_regola_5")
end
-- classificati_2
script.R_regola_6 = function(u)
  if m688.variabile_uguale(u, 206, 0) and su_unita(u, 3, m688.classificato, 0, 1) then
    m688.variabile(u, 206, 1)
    m688.variabile(u, 305, 0)
    do return end
  end
  m688.dopo(u, 10, "R_regola_6")
end
-- registrata
script.R_regola_7 = function(u)
  if m688.variabile_uguale(u, 207, 0) and m688.obiettivo_compiuto(u, "firma") then
    m688.variabile(u, 207, 1)
    m688.messaggio(u, 140)
    do return end
  end
  m688.dopo(u, 10, "R_regola_7")
end
-- collisione
script.R_regola_8 = function(u)
  if m688.variabile_uguale(u, 208, 0) and m688.evento(u, "collisione", 0) then
    m688.variabile(u, 208, 1)
    m688.messaggio(u, 141)
    do return end
  end
  m688.dopo(u, 10, "R_regola_8")
end

return missione
