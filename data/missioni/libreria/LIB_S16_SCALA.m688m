-- attacco
script.R_regola_12 = function(u)
  if m688.variabile_uguale(u, 212, 0) and m688.variabile_uguale(u, 307, 1) and m688.variabile_maggiore(u, 308, 890) then
    m688.variabile(u, 212, 1)
    m688.variabile(u, 307, 2)
    m688.variabile(u, 310, 0)
    m688.situazione(u, "guerra", "luogo", "urss")
    m688.messaggio_al_giocatore(u, 1011)
    do return end
  end
  m688.dopo(u, 10, "R_regola_12")
end
-- emersi
script.R_regola_13 = function(u)
  if m688.variabile_uguale(u, 213, 0) and m688.variabile_uguale(u, 307, 1) and m688.in_superficie(u) then
    m688.variabile(u, 213, 1)
    m688.messaggio(u, 143)
    do return end
  end
  m688.dopo(u, 10, "R_regola_13")
end
-- fuori
script.R_regola_14 = function(u)
  if m688.variabile_uguale(u, 214, 0) and m688.obiettivo_compiuto(u, "foto") and m688.in_cerchio(u, table.unpack(ZONE["largo"])) then
    m688.variabile(u, 214, 1)
    m688.variabile(u, 303, 1)
    m688.messaggio(u, 140)
    do return end
  end
  m688.dopo(u, 10, "R_regola_14")
end

return missione
