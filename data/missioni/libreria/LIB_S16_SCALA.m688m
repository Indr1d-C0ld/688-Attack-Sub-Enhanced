-- orologio
script.R_regola_5 = function(u)
  if true and m688.variabile_uguale(u, 307, 1) then
    m688.variabile(u, 205, 1)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
    m688.variabile_piu(u, 308)
  end
  m688.dopo(u, 10, "R_regola_5")
end
-- perso
script.R_regola_6 = function(u)
  if true and m688.variabile_uguale(u, 307, 1) and su_unita(u, 3, m688.senza_contatto_da, 0, 10) and su_unita(u, 4, m688.senza_contatto_da, 0, 10) then
    m688.variabile(u, 206, 1)
    m688.variabile(u, 307, 0)
    m688.variabile(u, 308, 0)
    m688.messaggio_al_giocatore(u, 1005)
  end
  m688.dopo(u, 10, "R_regola_6")
end
-- segnalazione_1
script.R_regola_7 = function(u)
  if m688.variabile_uguale(u, 207, 0) and m688.variabile_uguale(u, 307, 1) and m688.variabile_maggiore(u, 308, 290) then
    m688.variabile(u, 207, 1)
    if m688.unita_esiste(u, 3) then
      m688.seleziona(u, 3)
      m688.rumore_transitorio(u)
    end
    m688.messaggio_al_giocatore(u, 1006)
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_7")
end
