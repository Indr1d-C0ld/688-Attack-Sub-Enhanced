script.R_8_p1 = function(u)
  m688.vai_a(u, 3686.4, 41144.7, 30, "")
  m688.salva_modello(u)
end

-- chiusura: codice 120 a missione conclusa, 121 a tempo scaduto (il giudizio lo danno gli obiettivi)
script.R_chiusura = function(u)
  m688.dopo(u, 20, "R_chiusura")
  do return end
  ::fine::
  m688.messaggio(u, 120)
end
script.R_tempo = function(u)
  m688.messaggio(u, 34)
  m688.messaggio(u, 121)
end

-- regole «quando... allora...» dell'editor: un controllo ogni 10 s sull'unita' della regola
local ZONE = {
  ["incontro"] = { 3686.4, 41144.7, 3704 },
  ["avvicinamento"] = { 3686.4, 41144.7, 22224 },
}
-- inizio
script.R_regola_0 = function(u)
  if m688.variabile_uguale(u, 200, 0) then
    m688.variabile(u, 200, 1)
    m688.variabile(u, 301, 1)
    m688.variabile(u, 302, 1)
    do return end
  end
  m688.dopo(u, 10, "R_regola_0")
end
-- troppo_veloce
script.R_regola_1 = function(u)
  if m688.variabile_uguale(u, 201, 0) and not m688.velocita_sotto(u, 12.5) then
    m688.variabile(u, 201, 1)
    m688.variabile(u, 301, 0)
    m688.messaggio_al_giocatore(u, 1001)
    do return end
  end
  m688.dopo(u, 10, "R_regola_1")
end
-- portelli
script.R_regola_2 = function(u)
  if m688.variabile_uguale(u, 202, 0) then
    m688.variabile(u, 202, 1)
    if m688.unita_esiste(u, 7) then
      m688.seleziona(u, 7)
      m688.posizione(u, -31649.5, 39743.1)
      m688.rotta_ora(u, 145.1)
      m688.velocita_ora(u, 6)
      m688.salva_modello(u)
    end
    m688.radio(u, "OSCAR")
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_2")
end
-- oscar_affondato
script.R_regola_3 = function(u)
  if m688.variabile_uguale(u, 203, 0) and m688.variabile_uguale(u, 202, 1) and not m688.unita_esiste(u, 7) then
    m688.variabile(u, 203, 1)
    m688.variabile(u, 303, 1)
    do return end
  end
  m688.dopo(u, 10, "R_regola_3")
end
-- lancio
script.R_regola_4 = function(u)
  if m688.variabile_uguale(u, 204, 0) and m688.variabile_uguale(u, 303, 0) then
    m688.variabile(u, 204, 1)
    m688.variabile(u, 302, 0)
    m688.radio(u, "LANCIO")
    do return end
  end
  m688.dopo(u, 10, "R_regola_4")
end
-- rapporto
script.R_regola_5 = function(u)
  if m688.variabile_uguale(u, 205, 0) and m688.trasmesso(u, "contatto", 5400) then
    m688.variabile(u, 205, 1)
    m688.variabile(u, 304, 1)
    do return end
  end
  m688.dopo(u, 10, "R_regola_5")
end
-- fregata
script.R_regola_6 = function(u)
  if m688.variabile_uguale(u, 206, 0) and m688.in_cerchio(u, table.unpack(ZONE["avvicinamento"])) then
    m688.variabile(u, 206, 1)
    if m688.unita_esiste(u, 8) then
      m688.seleziona(u, 8)
      m688.posizione(u, 6147.7, 42859.9)
      m688.rotta_ora(u, 235.1)
      m688.velocita_ora(u, 8)
      script.R_8_p1(u)
    end
    m688.seleziona(u, u)
    do return end
  end
  m688.dopo(u, 10, "R_regola_6")
end
-- a_casa
script.R_regola_7 = function(u)
  if m688.variabile_uguale(u, 207, 0) and m688.in_cerchio(u, table.unpack(ZONE["incontro"])) then
    m688.variabile(u, 207, 1)
    m688.messaggio(u, 140)
    do return end
  end
  m688.dopo(u, 10, "R_regola_7")
end

return missione
