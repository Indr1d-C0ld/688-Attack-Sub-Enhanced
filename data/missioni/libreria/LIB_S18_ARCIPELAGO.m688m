    obiettivi = {
      { id = "foto", tipo = "foto", unita = { 2 }, minimo = -1, entro_s = -1, primario = true, colpire = true, testo = { it = "Fotografare la base: la corvetta ormeggiata, entro 3 km", en = "Photograph the base: the moored corvette, within 3 km" }, distanza_m = 3000 },
      { id = "uscita", tipo = "variabile", unita = {  }, minimo = 1, entro_s = -1, primario = true, colpire = true, testo = { it = "Uscire dalle acque territoriali", en = "Leave territorial waters" }, indice = 3 },
      { id = "occulto", tipo = "variabile", unita = {  }, minimo = 1, entro_s = -1, primario = false, colpire = true, testo = { it = "Non farsi classificare ne' tenere", en = "Avoid being classified or held" }, indice = 5 },
      { id = "interne", tipo = "variabile", unita = {  }, minimo = 1, entro_s = -1, primario = false, colpire = true, testo = { it = "Non far chiudere l'arcipelago (scoperti nelle acque interne)", en = "Do not get the archipelago closed (found in the inner waters)" }, indice = 7 },
      { id = "vivo", tipo = "sopravvivere", unita = {  }, minimo = -1, entro_s = -1, primario = true, colpire = true, testo = { it = "Riportare a casa il battello", en = "Bring the boat home" } },
    },
    aerei_asw = {
      { unita = 6, base_unita = -1, situazione = "pace", contro_giocatore = true, bersagli = {  }, zona = { x = 134058.89974171293, y = 98932.465000333905 }, raggio = 12000 },
    },
    briefing = { it = { "ORDINI DI MISSIONE", "DA: COMSUBLANT", "A: USS LOS ANGELES (SSN-688)", "OGG.: RICOGNIZIONE DELL'ARCIPELAGO", "1 ottobre 1989, ore 2100Z. Teatro: Baltico, l'arcipelago di un paese neutrale. Crisi con quel paese. Notte, mare calmo, foschia, visibilita' 4 km.", "In fondo all'arcipelago c'e' una base navale. Fotografatela, la corvetta ormeggiata da meno di 3 km, e uscite. L'acqua e' poca: fra 30 e 45 m nella parte esterna, meno all'interno.", "Il paese ha regole d'ingaggio a zone. Nelle acque esterne, se vi trova, vi avverte e vi caccia fuori col sonar, senza sparare. Nelle acque interne chiude l'area: le mine dell'ingresso passano a una stazione a terra che le fa scoppiare sotto chi ci passa sopra, e le corvette sparano per danneggiare o affondare.", "Se emergete nelle acque esterne, vi scortano fuori: il battello e' salvo, la missione no.", "Regole d'ingaggio: armi trattenute. Non rispondete al fuoco.", "Tempo a disposizione: 2 ore e 30.", "Nota storica: ispirata alle incursioni negli arcipelaghi svedesi (Hårsfjärden, ottobre 1982) e alle regole adottate dopo. Chi fossero gli intrusi e' molto conteso. Paese, nomi e unita' di fantasia.", }, en = { "MISSION ORDERS", "FM: COMSUBLANT", "TO: USS LOS ANGELES (SSN-688)", "SUBJ: ARCHIPELAGO RECONNAISSANCE", "1 October 1989, 2100Z. Theatre: Baltic, the archipelago of a neutral country. Crisis with that country. Night, calm sea, haze, visibility 4 km.", "At the head of the archipelago lies a naval base. Photograph it, the moored corvette from within 3 km, and come out. The water is shallow: 30 to 45 m in the outer part, less inside.", "The country has zoned rules of engagement. In the outer waters, if they find you, they warn you and chase you out with sonar, without firing. In the inner waters they close the area: the entrance mines pass to a shore station that fires them under whoever passes over, and the corvettes fire to damage or sink.", "If you surface in the outer waters, they escort you out: the boat is safe, the mission is not.", "Rules of engagement: weapons hold. Do not return fire.", "Time available: 2 hours 30.", "Historical note: inspired by the incursions into the Swedish archipelagos (Hårsfjärden, October 1982) and the rules adopted afterwards. Who the intruders were is much disputed. Country, names and units are fictional.", } },
    esito_fine = { it = "Missione conclusa: rientrare alla base per il rapporto.", en = "Mission over: return to base for debriefing." }, esito_tempo = { it = "Tempo scaduto: la missione si chiude qui.", en = "Time is up: the mission ends here." },
