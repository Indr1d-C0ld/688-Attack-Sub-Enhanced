-- chiusa
script.R_regola_5 = function(u)
  if m688.variabile_uguale(u, 205, 0) and m688.in_cerchio(u, table.unpack(ZONE["interne"])) and m688.variabile_uguale(u, 305, 0) and m688.variabile_uguale(u, 307, 1) then
    m688.variabile(u, 205, 1)
